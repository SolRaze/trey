# Relay core: background sysmodule, base memory region.
# Title id 0004013000F0E702; Luma's loader takes it from /luma/sysmodules/0004013000F0E702.cxi
# (enable_external_firm_and_modules = 1), so it is never installed. The low byte must be 02:
# PM panics on a 00040130 launch whose low byte is not the system core version.
BasicInfo:
  Title                   : rcore
  CompanyCode             : "00"
  ProductCode             : relay-core
  ContentType             : Application
  Logo                    : None

TitleInfo:
  UniqueId                : 0xF0E7
  Category                : Base
  Version                 : 2

Option:
  UseOnSD                 : false
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCrypt             : false
  EnableCompress          : true

AccessControlInfo:
  IdealProcessor                : 1
  AffinityMask                  : 3
  Priority                      : 48
  DisableDebug                  : false
  EnableForceDebug              : true
  CanWriteSharedPage            : false
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : false
  PermitMainFunctionArgument    : false
  CanShareDeviceMemory          : true
  RunnableOnSleep               : true
  SpecialMemoryArrange          : false
  ResourceLimitCategory         : Other
  CoreVersion                   : 2
  DescVersion                   : 2
  MemoryType                    : Base
  HandleTableSize               : 128
  SystemCallAccess: 
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    GetProcessAffinityMask: 4
    SetProcessAffinityMask: 5
    GetProcessIdealProcessor: 6
    SetProcessIdealProcessor: 7
    CreateThread: 8
