[Unit]
Description=Relay's knave side for trey (the 3DS): save sync with Azahar, CIA inbox, Azahar wake, plain HTTP
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=sol
ExecStart=/usr/bin/python3 /srv/relay/knave.py 8740
Restart=always
# reads Azahar's saves under /srv/docker (root 0710) without opening that tree to sol
AmbientCapabilities=CAP_DAC_READ_SEARCH
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
